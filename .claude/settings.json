{
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git mv:*)",
      "Bash(python3 .claude/skills/migrate-vibin/migrate-plan.py:*)",
      "Bash(pnpm:*)",
      "Bash(pnpx:*)",
      "Bash(node:*)",
      "Bash(tsc:*)",
      "Bash(tsx:*)",
      "Read(//home/dexter/.claude/practices/**)",
      "Bash(curl -sSL --max-time 20 -o /dev/null -w \"HTTP %{http_code} size=%{size_download}\\\\n\" \"https://raw.githubusercontent.com/dwyl/english-words/master/words_alpha.txt\")",
      "Bash(curl -sSL --max-time 30 -o /dev/null -w \"HTTP %{http_code} size=%{size_download}\\\\n\" \"https://www2.census.gov/topics/genealogy/2010surnames/Names_2010Census.csv\")",
      "Bash(curl -sSL --max-time 10 -o /dev/null -w \"HTTP %{http_code} size=%{size_download}\\\\n\" \"https://www.ssa.gov/oact/babynames/names.zip\")",
      "Bash(curl -sSL --max-time 15 -A \"Mozilla/5.0\" -o /dev/null -w \"HTTP %{http_code} size=%{size_download}\\\\n\" \"https://www.ssa.gov/oact/babynames/names.zip\")"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/wiki-context.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Write|Edit|NotebookEdit|Bash|Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/wiki-gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/wiki-gate.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/wiki-sync-reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
