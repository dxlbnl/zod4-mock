{
  "name": "playground",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fix": "pnpm lint:fix && pnpm fmt",
    "test:e2e": "playwright install && playwright test",
    "test": "pnpm test:unit && pnpm test:component",
    "test:unit": "vitest --config vitest.unit.config.ts --run",
    "test:component": "vitest --run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "zod4-mock": "workspace:*"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.2",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-themes": "10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/sveltekit": "^10.3.6",
    "@sveltejs/adapter-vercel": "^5.0.2",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^24",
    "@vitest/browser-playwright": "^4.1.3",
    "@vitest/coverage-v8": "4.1.5",
    "playwright": "^1.59.1",
    "storybook": "^10.3.6",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "vitest": "^4.1.3",
    "vitest-browser-svelte": "^2.1.0"
  }
}
