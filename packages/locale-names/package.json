{
  "name": "@zod4-mock/locale-names",
  "version": "0.2.1",
  "description": "Pre-trained Markov name models by cultural origin for zod4-mock locales",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./groups/dutch": {
      "types": "./dist/groups/dutch/index.d.ts",
      "import": "./dist/groups/dutch/index.js"
    },
    "./groups/arabic": {
      "types": "./dist/groups/arabic/index.d.ts",
      "import": "./dist/groups/arabic/index.js"
    },
    "./groups/turkish": {
      "types": "./dist/groups/turkish/index.d.ts",
      "import": "./dist/groups/turkish/index.js"
    },
    "./groups/frisian": {
      "types": "./dist/groups/frisian/index.d.ts",
      "import": "./dist/groups/frisian/index.js"
    },
    "./groups/english": {
      "types": "./dist/groups/english/index.d.ts",
      "import": "./dist/groups/english/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "fetch-data": "tsx scripts/fetch-data.ts",
    "train": "tsx scripts/train.ts",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@zod4-mock/locale-core": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
