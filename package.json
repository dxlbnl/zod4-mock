{
  "name": "zod4-mock",
  "version": "0.1.0",
  "description": "Deterministic, schema-driven mock data generator for Zod v4",
  "keywords": [
    "deterministic",
    "faker",
    "fixture",
    "mock",
    "test",
    "zod",
    "zod4"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:45343/git/dxlbnl/refactored-funicular"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fix": "pnpm lint:fix && pnpm fmt",
    "play": "vitest run --config vitest.playground.config.ts --reporter=verbose",
    "play:watch": "vitest --config vitest.playground.config.ts --reporter=verbose"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@vitest/ui": "4.1.5",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
