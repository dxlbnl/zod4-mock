{
  "name": "zod4-mock",
  "version": "0.1.2",
  "description": "Deterministic, schema-driven mock data generator for Zod v4",
  "keywords": [
    "deterministic",
    "faker",
    "fixture",
    "mock",
    "test",
    "zod",
    "zod4"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxlbnl/zod4-mock.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fix": "pnpm lint:fix && pnpm fmt",
    "test:all": "pnpm -r --include-workspace-root test",
    "lint:all": "pnpm -r --include-workspace-root lint",
    "fmt:all": "pnpm -r --include-workspace-root fmt",
    "fix:all": "pnpm -r --include-workspace-root fix",
    "check:all": "pnpm typecheck && pnpm -r check",
    "validate": "pnpm check:all && pnpm test:all && pnpm lint:all && pnpm fmt:check",
    "play": "vitest run --config vitest.playground.config.ts --reporter=verbose",
    "play:watch": "vitest --config vitest.playground.config.ts --reporter=verbose"
  },
  "devDependencies": {
    "@types/node": "^25.6.1",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/ui": "4.1.5",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  }
}
