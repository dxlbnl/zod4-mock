{
  "name": "zod4-mock",
  "version": "0.12.1",
  "description": "Deterministic, schema-driven mock data generator for Zod v4",
  "keywords": [
    "deterministic",
    "faker",
    "fixture",
    "mock",
    "test",
    "zod",
    "zod4"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dxlbnl/zod4-mock.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build && rm -rf dist && tsc -p tsconfig.build.json",
    "build:all": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fix": "pnpm lint:fix && pnpm fmt",
    "test:all": "pnpm -r --include-workspace-root test",
    "lint:all": "pnpm -r --include-workspace-root lint",
    "fmt:all": "pnpm -r --include-workspace-root fmt",
    "fix:all": "pnpm -r --include-workspace-root fix",
    "check:all": "pnpm typecheck && pnpm -r check",
    "validate": "pnpm check:all && pnpm test:all && pnpm lint:all && pnpm fmt:check",
    "play": "vitest run --config vitest.playground.config.ts",
    "play:watch": "vitest --config vitest.playground.config.ts",
    "fetch-data": "pnpm -r --filter './packages/*' fetch-data",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:all && changeset publish",
    "prepublishOnly": "pnpm build",
    "site:dev": "pnpm --filter @zod4-mock/site dev",
    "site:build": "pnpm --filter @zod4-mock/site build",
    "site:bench": "pnpm --filter @zod4-mock/site bench",
    "site:check": "pnpm --filter @zod4-mock/site check",
    "site:storybook": "pnpm --filter @zod4-mock/site storybook",
    "site:test:unit": "pnpm --filter @zod4-mock/site test:unit",
    "site:test:component": "pnpm --filter @zod4-mock/site test:component",
    "site:test:e2e": "pnpm --filter @zod4-mock/site test:e2e"
  },
  "dependencies": {
    "@zod4-mock/locale-core": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@shikijs/twoslash": "^4.2.0",
    "@types/node": "^25.6.1",
    "@vitest/coverage-v8": "4.1.5",
    "@vitest/ui": "4.1.5",
    "@zod4-mock/locale-en": "workspace:*",
    "@zod4-mock/locale-nl": "workspace:*",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "twoslash": "^0.3.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "@anatine/zod-mock>zod": "^3.24.4"
    }
  }
}
