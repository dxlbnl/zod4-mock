{
	"name": "gen-bench",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"fix": "pnpm lint:fix && pnpm fmt",
		"bench": "vitest --config bench/vitest.config.ts --run",
		"test": "pnpm test:unit && pnpm test:component",
		"test:unit": "vitest --config vitest.unit.config.ts --run",
		"test:component": "vitest --run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"dependencies": {
		"@anatine/zod-mock": "^3.14.0",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/language": "^6.12.3",
		"@codemirror/state": "^6.6.0",
		"@codemirror/view": "^6.42.1",
		"@faker-js/faker": "^10.4.0",
		"@lezer/highlight": "^1.2.3",
		"@zod4-mock/locale-en": "0.4.0",
		"@zod4-mock/locale-nl": "0.4.0",
		"chart.js": "^4.5.1",
		"mdsvex": "^0.12.7",
		"shiki": "^4.0.2",
		"svelte-chartjs": "^4.0.1",
		"zod": "^4.4.3",
		"zod3": "npm:zod@^3.25.76",
		"zod4-mock": "0.5.0"
	},
	"pnpm": {
		"overrides": {
			"@anatine/zod-mock>zod": "^3.24.4"
		}
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@playwright/test": "^1.60.0",
		"@storybook/addon-a11y": "^10.4.0",
		"@storybook/addon-docs": "^10.4.0",
		"@storybook/addon-svelte-csf": "^5.1.2",
		"@storybook/addon-themes": "^10.4.0",
		"@storybook/addon-vitest": "^10.4.0",
		"@storybook/sveltekit": "^10.4.0",
		"@sveltejs/adapter-vercel": "6",
		"@sveltejs/kit": "^2.59.1",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.7.0",
		"@vitest/browser-playwright": "^4.1.6",
		"@vitest/coverage-v8": "^4.1.6",
		"oxfmt": "latest",
		"oxlint": "latest",
		"playwright": "^1.60.0",
		"storybook": "^10.4.0",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.8",
		"typescript": "^6.0.3",
		"vite": "^8.0.13",
		"vitest": "^4.1.6",
		"vitest-browser-svelte": "^2.1.1"
	}
}
