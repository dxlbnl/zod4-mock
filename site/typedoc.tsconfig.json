{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "..",
    "paths": {
      "zod4-mock": ["./src/index.ts"]
    }
  },
  "include": ["../src/**/*.ts"],
  "exclude": ["../node_modules", "../dist", "../tests", "../src/**/*.test.ts"]
}
